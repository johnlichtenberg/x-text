# Whitelist: ignore everything, then un-ignore ONLY the public paths. private/, merge.py,
# config.json, REFRESH.md and raw tool outputs can therefore never be staged by accident.
# merge.py's publish step also stages only this same explicit list.
# relay/ (the Cloudflare Worker) stays local too. The webhook URL/key live only in the Worker's secrets.
/*
!/.gitignore
!/README.md
!/index.html
!/app.js
!/search.js
!/parent.js
!/style.css
!/tests/
/tests/*
!/tests/search.test.js
!/tests/render.test.js
!/tests/parent.test.js
!/tests/load.test.js
!/data/
/data/*
!/data/posts.json
!/data/following.json
!/data/site.json
!/data/parents.json
!/data/index.json
!/data/gate.json
!/data/shards/
/data/shards/*
!/data/shards/*.json
!/data/parents/
/data/parents/*
!/data/parents/*.json
!/data/saved-searches/
/data/saved-searches/*
!/data/saved-searches/*.json
